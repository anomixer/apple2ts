export default "10 REM ** Applesoft BASIC Command Showcase **\n20 HOME : GOTO 40\n40 ?\"APPLESOFT BASIC DEMO\" : ?\"====================\"\n60 REM ** Variables and LET **\n70 LET X = 10 : Y = 20 - 10 : Z$ = \"HELLO\" : N% = -42\n110 PRINT \"X=\";X;\" Y=\";Y;\" Z$=\";Z$\n130 REM ** Math Functions **\n140 PRINT \"INT(+3.7)=\";INT(+3.7);: PRINT \" ABS(-5)=\";ABS(-5) + 0\n160 PRINT \"SGN(-10)=\";SGN(-10);: PRINT \" SQR(16)=\";SQR(16)\n180 PRINT \"RND(1)=\";RND(1)\n200 REM ** String Functions **\n210 A$ = \"APPLE\"\n220 PRINT \"LEN(A$)=\";LEN(A$);: ?\" LEFT$(A$,3)=\";LEFT$(A$,3)\n240 ?\"RIGHT$(A$,2)=\";RIGHT$(A$,2);: ?\" MID$(A$,2,3)=\";MID$(A$,2,3)\n260 PRINT \"ASC('A')=\";ASC(\"A\");: ?\" CHR$(65)=\";CHR$(65)\n280 PRINT \"STR$(123)=\";STR$(123);: ?\" VAL('456')=\";VAL(\"456\")\n310 REM ** Logical Operators **\n320 IF X > 5 AND Y < 30 THEN PRINT \"AND \";\n330 IF X = 0 OR Y = 20 THEN PRINT \"OR \";\n340 IF NOT X = 0 THEN PRINT \"NOT \"\n360 REM ** FOR/NEXT Loop **\n370 PRINT \"COUNTING:\";\n380 FOR I = 1 TO 5 : PRINT \"  \";I; : NEXT\n410 PRINT : PRINT \"STEP LOOP;\";\n430 FOR J = 10 TO 20 STEP 2 : ?\"  \";J;: NEXT J\n460 PRINT\n480 REM ** Arrays with DIM **\n490 DIM A(5)\n500 FOR I = 0 TO 5 : A(I) = I * 2 : NEXT I\n530 PRINT \"ARRAY VALUES:\";\n540 FOR I = 0 TO 5 : PRINT \"  A(\";I;\")=\";A(I); : NEXT I\n570 PRINT\n580 REM ** GOSUB/RETURN **\n590 PRINT \"CALLING SUBROUTINE...\";\n600 GOSUB 1000\n610 PRINT \"BACK\"\n630 REM ** DATA/READ/RESTORE **\n640 PRINT \"READING DATA: \";\n650 READ D1,D2,D3\n660 PRINT \"  \";D1;D2;D3\n670 RESTORE\n680 READ D1\n690 PRINT \"  AFTER RESTORE: \";D1\n710 REM ** HTAB/VTAB Positioning **\n720 VTAB 19 : HTAB 5\n740 PRINT \"POSITIONED TEXT\"\n760 REM ** INPUT Example **\n770 REM ** POKE/PEEK Example **\n780 POKE 768,169 :V = PEEK(768) : ?\"PEEK(768)=\";V\n790 INPUT \"ENTER YOUR NAME: \"; N$\n800 REM ** IF/THEN/GOTO **\n810 IF N$ = \"\" THEN GOTO 900\n830 PRINT \"HELLO, \";N$;\". Press <ESC> to exit.\"\n850 IF PEEK(49152) = 27 THEN GOTO 900\n860 GOTO 830\n900 SPEED = 255\n910 PRINT \"PRESS ANY KEY TO EXIT\"\n920 GET K$ : TEXT : HOME\n930 END\n945 GOTO 945 : REM Never reached but tests renumber\n950 GOTO 930 : REM Never reached but tests renumber\n955 CALL -151\n960 REM ** Data Section **\n970 DATA 100,200,300\n980 REM ** Subroutine **\n1000 PRINT \"  INSIDE... \";\n1010 RETURN"